---
import Layout from "../../layouts/Layout.astro";

const BASE = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
---

<Layout title="WIP / SLOT LAB" bodyClass="page-wip-games">
  <div class="wip-container fade-in-section">
    <h1 class="wip-title">WIP / SLOT LAB</h1>
    
    <div class="wip-content">
      <p>こちらは開発中の試作置き場です。<br>正式なコンテンツは一覧ページをご覧ください。</p>
    </div>

    <div class="wip-action-group">
      <a href={`${BASE}/wip/games/celestial-slot/`} class="btn-slot-list">コラボスロット一覧へ</a>
      <a href={import.meta.env.BASE_URL} class="btn-back">HOMEへ戻る</a>
    </div>
  </div>
</Layout>

<style>
  .wip-container {
    max-width: 800px;
    margin: 120px auto;
    padding: 40px 20px;
    text-align: center;
    color: #fff;
  }

  .wip-title {
    font-size: 2.5rem;
    color: var(--c-accent, #0ff);
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.5);
    margin-bottom: 2rem;
    font-family: "Zen Kaku Gothic New", sans-serif;
    letter-spacing: 0.1em;
  }

  .wip-content {
    font-family: sans-serif;
    font-size: 1.0rem;
    font-weight: 500;
    line-height: 2.0;
    margin-bottom: 4rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .wip-action-group {
    display: flex;
    flex-direction: column;
    gap: 30px;
    align-items: center;
  }

  .btn-slot-list {
    display: flex;
    justify-content: center;
    align-items: center;
    min-width: 260px;
    padding: 14px 24px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: bold;
    font-family: "Segoe UI", sans-serif;
    letter-spacing: 1px;
    transition: all 0.2s ease;
    border: 1px solid rgba(0, 255, 255, 0.3);
    background: rgba(0, 20, 40, 0.6);
    color: #0ff;
    box-shadow: 0 0 10px rgba(0, 255, 255, 0.1);
  }
  
  .btn-slot-list:hover {
    background: rgba(0, 40, 80, 0.8);
    box-shadow: 0 0 20px rgba(0, 255, 255, 0.4);
    transform: translateY(-2px);
    color: #fff;
    border-color: #fff;
  }

  .btn-back {
    display: inline-block;
    padding: 10px 24px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 30px;
    color: #aaa;
    text-decoration: none;
    font-family: monospace;
    font-size: 0.85rem;
    transition: all 0.2s;
  }

  .btn-back:hover {
    color: #fff;
    border-color: #fff;
    background: rgba(255, 255, 255, 0.05);
  }
</style>
